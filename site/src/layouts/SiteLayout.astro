---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Arachne の思想、実装、デモを束ねる長編サイト。' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navItems = [
  { href: `${base}/`, label: 'Top' },
  { href: `${base}/essay/ai-era-microservices`, label: 'Essay' },
  { href: `${base}/demo`, label: 'Demo' },
  { href: `${base}/observations`, label: 'Observations' },
  { href: `${base}/conclusions`, label: 'Conclusions' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href={`${base}/`}>
          <span class="site-brand__mark">A</span>
          <span>
            <strong>Arachne Field Notes</strong>
            <small>AI era microservices</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="primary">
          {navItems.map((item) => (
            <a class:list={["site-nav__link", { 'is-active': currentPath === item.href || currentPath.startsWith(`${item.href}/`) }]} href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <div class="site-shell">
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <p>仮説・SDK・food-delivery-demo を 1 つの流れで読める静的サイト。</p>
        <p style="margin-top: 6px">
          <a href="https://github.com/mahitotsu/arachne" style="color: var(--accent)" target="_blank" rel="noopener noreferrer">GitHub: mahitotsu/arachne</a>
        </p>
      </footer>
    </div>
  </body>
</html>