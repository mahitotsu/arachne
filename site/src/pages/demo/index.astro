---
import PageHero from '../../components/PageHero.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const designRows = [
  {
    principle: 'AI エージェントは自然言語フロントドアとして追加する',
    impl: 'order-service に order-intake-agent を置いてユーザー入力の一次解釈を担わせ、menu-service・delivery-service・support-service は service-local agent として catalog grounding、ETA 判断、サポート対話を担わせます',
    check: 'order-service の suggest API が direct item request / recommendation request を正規化し、その handoff を受けた menu-service が明示指定優先で grounded な候補を返す流れで確認できます',
    obs: '01-natural-language-front-door',
  },
  {
    principle: '従来の API は機械間連携の正本契約として残す',
    impl: '全サービスが REST API と OpenAPI 仕様を公開し、エージェントはその API をツールとして呼び出す形を維持します',
    check: '/agents の API 仕様タブから各サービスの OpenAPI を確認できます。エージェントのツール定義も同じ API 上に乗っています',
    obs: '02-api-as-contract',
  },
  {
    principle: '金額計算・課金・認可は決定論的コードで処理する',
    impl: 'payment-service はエージェントを持たず、支払い準備と課金確定をコードで完結させます',
    check: 'payment-service の /v3/api-docs で、エージェント経由ではなく決定論的に処理されることを確認できます',
    obs: '03-deterministic-code',
  },
  {
    principle: 'system prompt はエンジニアが管理するシステム制約として書く',
    impl: '各エージェントの system prompt はソースコード中に置き、役割・制約・ツール利用方針・言語設定を明示します',
    check: '/agents のサービスカードを開くと、登録済みの system prompt をそのまま読めます',
    obs: '04-system-prompt-as-code',
  },
  {
    principle: 'skill は業務知識の公開面として分離する',
    impl: 'menu-service と kitchen-service は商品説明・推薦ロジック・仕込みスケジュール方針を SKILL.md に分離します。スキルの発動条件も SKILL.md のフロントマターに記述し、サービスが起動時に動的に注入します',
    check: '/agents のスキルタブで system prompt とは別に管理されているスキルドキュメントを確認できます',
    obs: '05-skill-separation',
    snippet: `# family-order-guide/SKILL.md（フロントマター抜粋）
---
name: family-order-guide
activationHint: 家族・複数人・子ども向けの相談のとき
---`,
  },
  {
    principle: 'サービス間の collaborator 解決は capability ベースで動的に行う',
    impl: 'order / kitchen / menu / support / delivery が起動時に registry-service へ自己登録し、ダウンストリーム解決は POST /registry/discover で行います',
    check: 'delivery-service が外部 ETA アダプターを discover 経由で発見し、ETA を比較して推奨を返すフローで確認できます',
    obs: '06-capability-discovery',
  },
  {
    principle: '会話責務・workflow 責務・仕様閲覧責務は UI レベルでも分離する',
    impl: 'カスタマー UI を /order（workflow）・/support（会話）・/agents（viewer）の 3 ページに分け、責務を混在させません',
    check: '/support は注文フローと独立しており、/order での workflow 処理中でも別タブでサポートに問い合わせできます',
  },
];

const principles = [
  {
    label: 'Organized around Business Capabilities',
    tension: 'AI を導入すると「エージェントが全部やる」という方向に引力が働き、サービスの責務境界が溶けるリスクがある。',
    evidence: 'order / menu / kitchen / delivery / support はそれぞれ異なる業務責務を持つ。エージェントを持つサービス同士でも役割は重ならず、6 サービスが同じ「AI 担当」として束ねられていない。',
    where: 'サービス一覧の役割列、/agents のサービスカード',
  },
  {
    label: 'Products not Projects',
    tension: 'system prompt や skill ドキュメントは「誰が管理するか」が曖昧になりやすい。エンジニア以外が触れない形になると陳腐化する。',
    evidence: 'system prompt と skill は各サービスのソースコードとして管理される。skill には activationHint が YAML フロントマターで書かれ、業務担当者がコードを触らずに適用条件を変更できる。DeterministicModel パターンにより振る舞いは再現可能な形でテストされている。',
    where: '/agents のスキルタブ、testing-agents Essay',
  },
  {
    label: 'Smart Endpoints and Dumb Pipes',
    tension: '複数サービスが同じ LLM バックエンドを使うとき、LLM がパイプになってサービス間ロジックを横断するリスクがある。また「正解が必要な処理」をエージェントに任せると非決定的になる。',
    evidence: 'payment-service はエージェントを持たない。課金確定は決定論的コードで実行する。各サービスの LLM 呼び出しは独自の system prompt と tool 定義で行われ、推論コンテキストはサービス境界に閉じている。サービス間通信は HTTP のみ。',
    where: 'サービス一覧の payment-service 行、/agents の API 仕様タブ（x-ai-prompt-contract）',
  },
  {
    label: 'Decentralized Governance / Decentralized Data Management',
    tension: 'サービス間で collaborator を直接参照すると、デプロイの独立性が失われる。registry を置いても、使い方次第で中央集権的な依存になりうる。',
    evidence: 'サービス間の collaborator 解決は POST /registry/discover（capability クエリ駆動）で行う。GET /registry/services は viewer 用途に分離し、サービス間の直接依存には使わない。各サービスは起動時に自己登録し、registry が落ちても既存の接続は維持される。',
    where: 'registry-service 行、capability-discovery Essay、/agents のサービスカード',
  },
];

const services = [
  {
    name: 'order-service',
    port: '8080',
    role: '注文ワークフロー coordinator / intent front door',
    agent: true,
    note: '4 ステップの workflow API（suggest → confirm-items → confirm-delivery → confirm-payment）を持ちます。order-intake-agent が suggest の自然言語 front door となり、direct item request / recommendation request を正規化したうえで menu / delivery / payment / support を registry 経由で動的に解決します。',
  },
  {
    name: 'menu-service',
    port: '8081',
    role: 'catalog grounding・代替候補提示',
    agent: true,
    note: 'order-service から受け取った正規化済み意図を live catalog に grounded な提案へ落とし込みます。direct item request では alias-based explicit match を優先し、exact match がない場合は menu-side alternatives だと明示します。欠品時は kitchen-service と連携して代替候補を提示します。',
  },
  {
    name: 'kitchen-service',
    port: '8082',
    role: 'キッチン状況管理',
    agent: true,
    note: '厄房のキャパシティと仕込み状況を管理します。注文確定時に準備スケジュールを調整し、混雑時は代替提案をエージェントが生成します。',
  },
  {
    name: 'delivery-service',
    port: '8083',
    role: '配送 ETA 評価・推奨',
    agent: true,
    note: 'registry-service を通じて外部 ETA サービスを動的に発見し、自社急配と比較して推奨配送プランを返します。capability-based discovery の主な実証箇所です。',
  },
  {
    name: 'payment-service',
    port: '8084',
    role: '支払い処理',
    agent: false,
    note: 'エージェントを持ちません。支払い準備と課金確定は決定論的コードで実行します。「正解が必要な処理はコードで守る」という設計方针の体現です。',
  },
  {
    name: 'customer-service',
    port: '8085',
    role: '認証・顧客情報管理',
    agent: false,
    note: 'デモアカウント認証（demo/demo-pass など）と顧客プロフィールを提供します。JWT 発行と JWKS 公開を担い、他サービスがトークンを検証します。',
  },
  {
    name: 'support-service',
    port: '8086',
    role: '会話型サポート窓口',
    agent: true,
    note: '注文フローとは分離した会話インターフェースです。FAQ・キャンペーン・サービス稼働状況・注文後フォローを扱います。[HANDOFF: order] で注文ページへの誘導も行います。',
  },
  {
    name: 'registry-service',
    port: '8087',
    role: 'サービス登録・capability 検索',
    agent: true,
    note: '各サービスが起動時に自己登録します。capability-registry-agent が POST /registry/discover で collaborator resolution を行い、GET /registry/services は viewer/inventory 用として意図的に分離されています。',
  },
  {
    name: 'hermes-adapter',
    port: '8088',
    role: '外部 ETA アダプター（常に遅延）',
    agent: false,
    note: '外部配送会社のモックです。15 秒サイクルで周期的に停止します。delivery-service が外部候補の可用性変動を正しく処理するかを検証できます。',
  },
  {
    name: 'idaten-adapter',
    port: '8089',
    role: '外部 ETA アダプター（常に最速）',
    agent: false,
    note: '外部配送会社のモックです。常に最短 ETA で AVAILABLE を返します。hermes-adapter と対にすることで、delivery-service の比較ロジックが機能することを確認できます。',
  },
];

const surfaces = [
  {
    path: '/order',
    title: '4 ステップ注文 UI',
    steps: ['意図入力', '商品選択', '配送選択', '支払い確認'],
    desc: 'ユーザーの注文意図を段階的に確定させる workflow-first UI です。各ステップで AI が提案と理由を返し、ユーザーが選択・調整します。会話的な自由入力と structured workflow の組み合わせが特徴です。',
  },
  {
    path: '/support',
    title: '会話型サポート',
    steps: ['FAQ', 'キャンペーン', '稼働状況確認', '注文後フォロー'],
    desc: '注文フローとは分離したサポート専用の会話窓口です。support-service のエージェントが対話を担います。注文関連の問い合わせには [HANDOFF: order] リンクで /order に誘導できます。',
  },
  {
    path: '/agents',
    title: 'サービスビューワー',
    steps: ['サービス一覧', 'プロンプト確認', 'スキル一覧', 'OpenAPI 仕様'],
    desc: 'registry-service の GET /registry/services を使い、登録済みサービスのカード一覧を表示します。各カードからシステムプロンプト・スキル・OpenAPI 仕様（x-ai-prompt-contract 含む）を確認できます。',
  },
];
---

<SiteLayout title="Demo | Arachne Field Notes">
  <PageHero
    eyebrow="Demo"
    title="food-delivery-demo ── 原則の緊張を動くコードで解消する"
    summary="5 つの設計原則が互いに矛盾せず Fowler/Lewis の特性とも整合しながら成立するか。food-delivery-demo はその問いに動くコードで答えるための実証環境です。"
  />

  <section class="panel">
    <p class="panel__eyebrow">このデモの読み方</p>
    <p>
      サービスの数やエージェントの数ではなく、<strong>各原則がどこで圧力を受け、どう解消されているか</strong>を確認することがこのデモの主眼です。
      以下に原則ごとの緊張（tension）と、デモの中でそれをどこで確認できるかを対応させています。
    </p>
  </section>

  <section class="panel">
    <p class="panel__eyebrow">サービス構成図</p>
    <p style="font-size:0.9rem; color:var(--text-muted); margin:0 0 20px">全サービスの依存関係。実線は通常の HTTP 呼び出し、点線はオプショナルまたは非同期の呼び出しを示します。</p>
    <pre class="mermaid">flowchart LR
    UI[customer-ui]
    CS[customer-service]
    OS[order-service]
    MS[menu-service]
    KS[kitchen-service]
    DS[delivery-service]
    PS[payment-service]
    SS[support-service]
    RS[registry-service]
    HA[hermes-adapter]
    IA[idaten-adapter]
    IC([icarus-adapter])
    DB[(PostgreSQL)]
    RD[(Redis)]

    UI --> CS
    UI --> OS
    OS --> MS
    OS --> DS
    OS --> PS
    OS -.->|post-order| SS
    MS --> KS
    OS -->|discover| RS
    DS -->|discover| RS
    RS --> HA
    RS --> IA
    RS -. not available .-> IC
    OS --> DB
    OS --> RD
    </pre>
  </section>

  <section class="panel">
    <p class="panel__eyebrow">注文フロー（4 ステップ）</p>
    <p style="font-size:0.9rem; color:var(--text-muted); margin:0 0 20px">カスタマーが注文を確定するまでの 4 ステップと、各ステップでのサービス間通信を示します。</p>
    <pre class="mermaid">sequenceDiagram
    actor B as Browser
    participant OS as order-service
    participant OA as order-intake-agent
    participant MS as menu-service
    participant KS as kitchen-service
    participant DS as delivery-service
    participant RS as registry-service
    participant PS as payment-service

    Note over B,PS: Step 1 — suggest
    B->>OS: POST /api/order/suggest
    OS->>OA: normalize intent
    OA-->>OS: NormalizedOrderIntent
    OS->>MS: grounding handoff
    MS->>KS: inventory check
    KS-->>MS: stock + ETA
    MS-->>OS: MenuSelectionDecision
    OS-->>B: suggested items

    Note over B,PS: Step 2 — confirm-items
    B->>OS: POST /api/order/confirm-items
    OS-->>B: items confirmed

    Note over B,PS: Step 3 — confirm-delivery
    B->>OS: POST /api/order/confirm-delivery
    OS->>DS: delivery options
    DS->>RS: discover ETA services
    RS-->>DS: hermes + idaten
    DS-->>OS: DeliveryPlan
    OS-->>B: delivery options

    Note over B,PS: Step 4 — confirm-payment
    B->>OS: POST /api/order/confirm-payment
    OS->>PS: charge
    PS-->>OS: charged
    OS-->>B: order confirmed
    </pre>
  </section>

  <section class="stacked-list">
    <h2 style="font-size:1.1rem; color:var(--text-muted); font-weight:600; margin-bottom:-8px">原則ごとの緊張と証拠</h2>
    {principles.map((p) => (
      <article class="essay-card">
        <div>
          <p class="panel__eyebrow">{p.label}</p>
          <p><strong>緊張：</strong>{p.tension}</p>
          <p><strong>解消：</strong>{p.evidence}</p>
          <p style="font-size:0.85rem; color:var(--text-muted)"><strong>確認場所：</strong>{p.where}</p>
        </div>
      </article>
    ))}
  </section>

  <section>
    <h2 style="font-size:1.05rem; font-weight:700; margin-bottom:16px; color:var(--text-muted); letter-spacing:0.02em; text-transform:uppercase; font-family:var(--font-mono)">設計原則と実装の対応</h2>
    <div class="table-shell">
      <table>
        <thead>
          <tr>
            <th>設計原則</th>
            <th>food-delivery-demo での実装</th>
            <th>どこで確認できるか</th>
          </tr>
        </thead>
        <tbody>
          {designRows.map((row) => (
            <tr>
              <td>{row.principle}</td>
              <td>{row.impl}</td>
              <td>
                <span>{row.check}</span>
                {row.snippet && (
                  <pre style="margin-top:8px; font-size:0.78rem; background:var(--surface-2, #f5f5f5); padding:8px 10px; border-radius:6px; overflow-x:auto; white-space:pre-wrap;"><code>{row.snippet}</code></pre>
                )}
                {row.obs && (
                  <a href={`${base}/observations/${row.obs}`} style="display:inline-block; margin-top:6px; font-size:0.82rem; color:var(--accent);">→ 観測ログ</a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="table-shell">
    <h2 style="font-size:1.1rem; color:var(--text-muted); font-weight:600; margin-bottom:8px">サービス構成</h2>
    <table>
      <thead>
        <tr>
          <th>サービス</th>
          <th>ポート</th>
          <th>役割</th>
          <th>エージェント</th>
          <th>設計ポイント</th>
        </tr>
      </thead>
      <tbody>
        {services.map((s) => (
          <tr>
            <td><code>{s.name}</code></td>
            <td>{s.port}</td>
            <td>{s.role}</td>
            <td style="white-space:nowrap">{s.agent ? '✓ あり' : '─ なし'}</td>
            <td>{s.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="stacked-list">
    <h2 style="font-size:1.1rem; color:var(--text-muted); font-weight:600; margin-bottom:-8px">カスタマー UI の 3 つの公開面</h2>
    {surfaces.map((s) => (
      <article class="essay-card">
        <div>
          <p class="panel__eyebrow">{s.path}</p>
          <h2>{s.title}</h2>
          <p>{s.desc}</p>
        </div>
        <div class="tag-row">
          {s.steps.map((step) => (
            <span class="tag-chip">{step}</span>
          ))}
        </div>
      </article>
    ))}
  </section>

  <section class="two-column-band">
    <article class="panel">
      <p class="panel__eyebrow">起動方法</p>
      <p>
        リポジトリの <code>food-delivery-demo/</code> ディレクトリで <code>make up</code> を実行すると、
        Docker Compose で全サービスが起動します。Bedrock を使う場合は <code>make up-bedrock</code>。
        AWS 認証情報は <code>aws configure export-credentials</code> 経由で渡されます。
      </p>
    </article>
    <article class="panel panel--soft">
      <p class="panel__eyebrow">実行履歴（Execution History）について</p>
      <p>
        注文ワークフローの各ステップを進めると、5 サービスの実行イベントが時系列で記録されます。
        <code>/order</code> の UI から「実行履歴」パネルを開くと、サービス・カテゴリ・結果・ツール使用・トークン消費を確認できます。
        エージェントの判断過程を追うための証拠面として設計しています。
      </p>
    </article>
  </section>
</SiteLayout>

<style is:global>
  pre.mermaid {
    background: var(--surface-soft);
    border-radius: var(--radius-md);
    overflow-x: auto;
    padding: 16px;
    margin: 0;
  }
  pre.mermaid svg {
    display: block;
    margin: 0 auto;
    max-width: 100%;
  }
</style>

<script is:inline type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
  mermaid.initialize({
    startOnLoad: true,
    theme: 'neutral',
    fontFamily: 'system-ui, -apple-system, "Helvetica Neue", sans-serif',
  });
</script>
