---
import PageHero from '../../components/PageHero.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const principles = [
  {
    label: 'Organized around Business Capabilities',
    tension: 'AI を導入すると「エージェントが全部やる」という方向に引力が働き、サービスの責務境界が溶けるリスクがある。',
    evidence: 'order / menu / kitchen / delivery / support はそれぞれ異なる業務責務を持つ。エージェントを持つサービス同士でも役割は重ならず、6 サービスが同じ「AI 担当」として束ねられていない。',
    where: 'サービス一覧の役割列、/agents のサービスカード',
  },
  {
    label: 'Products not Projects',
    tension: 'system prompt や skill ドキュメントは「誰が管理するか」が曖昧になりやすい。エンジニア以外が触れない形になると陳腐化する。',
    evidence: 'system prompt と skill は各サービスのソースコードとして管理される。skill には activationHint が YAML フロントマターで書かれ、業務担当者がコードを触らずに適用条件を変更できる。DeterministicModel パターンにより振る舞いは再現可能な形でテストされている。',
    where: '/agents のスキルタブ、testing-agents Essay',
  },
  {
    label: 'Smart Endpoints and Dumb Pipes',
    tension: '複数サービスが同じ LLM バックエンドを使うとき、LLM がパイプになってサービス間ロジックを横断するリスクがある。また「正解が必要な処理」をエージェントに任せると非決定的になる。',
    evidence: 'payment-service はエージェントを持たない。課金確定は決定論的コードで実行する。各サービスの LLM 呼び出しは独自の system prompt と tool 定義で行われ、推論コンテキストはサービス境界に閉じている。サービス間通信は HTTP のみ。',
    where: 'サービス一覧の payment-service 行、/appendix の x-ai-prompt-contract',
  },
  {
    label: 'Decentralized Governance / Decentralized Data Management',
    tension: 'サービス間で collaborator を直接参照すると、デプロイの独立性が失われる。registry を置いても、使い方次第で中央集権的な依存になりうる。',
    evidence: 'サービス間の collaborator 解決は POST /registry/discover（capability クエリ駆動）で行う。GET /registry/services は viewer 用途に分離し、サービス間の直接依存には使わない。各サービスは起動時に自己登録し、registry が落ちても既存の接続は維持される。',
    where: 'registry-service 行、capability-discovery Essay、/appendix の discover vs services 区別',
  },
];

const services = [
  {
    name: 'order-service',
    port: '8080',
    role: '注文ワークフロー coordinator / intent front door',
    agent: true,
    note: '4 ステップの workflow API（suggest → confirm-items → confirm-delivery → confirm-payment）を持ちます。order-intake-agent が suggest の自然言語 front door となり、direct item request / recommendation request を正規化したうえで menu / delivery / payment / support を registry 経由で動的に解決します。',
  },
  {
    name: 'menu-service',
    port: '8081',
    role: 'catalog grounding・代替候補提示',
    agent: true,
    note: 'order-service から受け取った正規化済み意図を live catalog に grounded な提案へ落とし込みます。direct item request では alias-based explicit match を優先し、exact match がない場合は menu-side alternatives だと明示します。欠品時は kitchen-service と連携して代替候補を提示します。',
  },
  {
    name: 'kitchen-service',
    port: '8082',
    role: 'キッチン状況管理',
    agent: true,
    note: '厄房のキャパシティと仕込み状況を管理します。注文確定時に準備スケジュールを調整し、混雑時は代替提案をエージェントが生成します。',
  },
  {
    name: 'delivery-service',
    port: '8083',
    role: '配送 ETA 評価・推奨',
    agent: true,
    note: 'registry-service を通じて外部 ETA サービスを動的に発見し、自社急配と比較して推奨配送プランを返します。capability-based discovery の主な実証箇所です。',
  },
  {
    name: 'payment-service',
    port: '8084',
    role: '支払い処理',
    agent: false,
    note: 'エージェントを持ちません。支払い準備と課金確定は決定論的コードで実行します。「正解が必要な処理はコードで守る」という設計方针の体現です。',
  },
  {
    name: 'customer-service',
    port: '8085',
    role: '認証・顧客情報管理',
    agent: false,
    note: 'デモアカウント認証（demo/demo-pass など）と顧客プロフィールを提供します。JWT 発行と JWKS 公開を担い、他サービスがトークンを検証します。',
  },
  {
    name: 'support-service',
    port: '8086',
    role: '会話型サポート窓口',
    agent: true,
    note: '注文フローとは分離した会話インターフェースです。FAQ・キャンペーン・サービス稼働状況・注文後フォローを扱います。[HANDOFF: order] で注文ページへの誘導も行います。',
  },
  {
    name: 'registry-service',
    port: '8087',
    role: 'サービス登録・capability 検索',
    agent: true,
    note: '各サービスが起動時に自己登録します。capability-registry-agent が POST /registry/discover で collaborator resolution を行い、GET /registry/services は viewer/inventory 用として意図的に分離されています。',
  },
  {
    name: 'hermes-adapter',
    port: '8088',
    role: '外部 ETA アダプター（常に遅延）',
    agent: false,
    note: '外部配送会社のモックです。15 秒サイクルで周期的に停止します。delivery-service が外部候補の可用性変動を正しく処理するかを検証できます。',
  },
  {
    name: 'idaten-adapter',
    port: '8089',
    role: '外部 ETA アダプター（常に最速）',
    agent: false,
    note: '外部配送会社のモックです。常に最短 ETA で AVAILABLE を返します。hermes-adapter と対にすることで、delivery-service の比較ロジックが機能することを確認できます。',
  },
];

const surfaces = [
  {
    path: '/order',
    title: '4 ステップ注文 UI',
    steps: ['意図入力', '商品選択', '配送選択', '支払い確認'],
    desc: 'ユーザーの注文意図を段階的に確定させる workflow-first UI です。各ステップで AI が提案と理由を返し、ユーザーが選択・調整します。会話的な自由入力と structured workflow の組み合わせが特徴です。',
  },
  {
    path: '/support',
    title: '会話型サポート',
    steps: ['FAQ', 'キャンペーン', '稼働状況確認', '注文後フォロー'],
    desc: '注文フローとは分離したサポート専用の会話窓口です。support-service のエージェントが対話を担います。注文関連の問い合わせには [HANDOFF: order] リンクで /order に誘導できます。',
  },
  {
    path: '/agents',
    title: 'サービスビューワー',
    steps: ['サービス一覧', 'プロンプト確認', 'スキル一覧', 'OpenAPI 仕様'],
    desc: 'registry-service の GET /registry/services を使い、登録済みサービスのカード一覧を表示します。各カードからシステムプロンプト・スキル・OpenAPI 仕様（x-ai-prompt-contract 含む）を確認できます。',
  },
];
---

<SiteLayout title="Demo | Arachne Field Notes">
  <PageHero
    eyebrow="Demo"
    title="food-delivery-demo ── 原則の緊張を動くコードで解消する"
    summary="5 つの設計原則が互いに矛盾せず Fowler/Lewis の特性とも整合しながら成立するか。food-delivery-demo はその問いに動くコードで答えるための実証環境です。"
  />

  <section class="panel">
    <p class="panel__eyebrow">このデモの読み方</p>
    <p>
      サービスの数やエージェントの数ではなく、<strong>各原則がどこで圧力を受け、どう解消されているか</strong>を確認することがこのデモの主眼です。
      以下に原則ごとの緊張（tension）と、デモの中でそれをどこで確認できるかを対応させています。
    </p>
  </section>

  <section class="stacked-list">
    <h2 style="font-size:1.1rem; color:var(--text-muted); font-weight:600; margin-bottom:-8px">原則ごとの緊張と証拠</h2>
    {principles.map((p) => (
      <article class="essay-card">
        <div>
          <p class="panel__eyebrow">{p.label}</p>
          <p><strong>緊張：</strong>{p.tension}</p>
          <p><strong>解消：</strong>{p.evidence}</p>
          <p style="font-size:0.85rem; color:var(--text-muted)"><strong>確認場所：</strong>{p.where}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="table-shell">
    <h2 style="font-size:1.1rem; color:var(--text-muted); font-weight:600; margin-bottom:8px">サービス構成</h2>
    <table>
      <thead>
        <tr>
          <th>サービス</th>
          <th>ポート</th>
          <th>役割</th>
          <th>エージェント</th>
          <th>設計ポイント</th>
        </tr>
      </thead>
      <tbody>
        {services.map((s) => (
          <tr>
            <td><code>{s.name}</code></td>
            <td>{s.port}</td>
            <td>{s.role}</td>
            <td style="white-space:nowrap">{s.agent ? '✓ あり' : '─ なし'}</td>
            <td>{s.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="stacked-list">
    <h2 style="font-size:1.1rem; color:var(--text-muted); font-weight:600; margin-bottom:-8px">カスタマー UI の 3 つの公開面</h2>
    {surfaces.map((s) => (
      <article class="essay-card">
        <div>
          <p class="panel__eyebrow">{s.path}</p>
          <h2>{s.title}</h2>
          <p>{s.desc}</p>
        </div>
        <div class="tag-row">
          {s.steps.map((step) => (
            <span class="tag-chip">{step}</span>
          ))}
        </div>
      </article>
    ))}
  </section>

  <section class="two-column-band">
    <article class="panel">
      <p class="panel__eyebrow">起動方法</p>
      <p>
        リポジトリの <code>food-delivery-demo/</code> ディレクトリで <code>make up</code> を実行すると、
        Docker Compose で全サービスが起動します。Bedrock を使う場合は <code>make up-bedrock</code>。
        AWS 認証情報は <code>aws configure export-credentials</code> 経由で渡されます。
      </p>
    </article>
    <article class="panel panel--soft">
      <p class="panel__eyebrow">実行履歴（Execution History）について</p>
      <p>
        注文ワークフローの各ステップを進めると、5 サービスの実行イベントが時系列で記録されます。
        <code>/order</code> の UI から「実行履歴」パネルを開くと、サービス・カテゴリ・結果・ツール使用・トークン消費を確認できます。
        エージェントの判断過程を追うための証拠面として設計しています。
      </p>
    </article>
  </section>
</SiteLayout>
