---
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const pillars = [
  {
    title: '問いと仮説',
    body: 'マイクロサービスの原則（責務境界・API 公開・チームの自律性・疎結合）を崩さずに AI エージェントを組み込むとどうなるか。その答えとして浮かびあがったのが「自然言語フロントドア」──エージェントを API の代替ではなく API の手前に置く設計です。',
  },
  {
    title: 'Arachne',
    body: 'AWS Strands Agents の Python SDK を Java に移植し、Spring Boot 統合を加えたエージェント実行フレームワークです。Spring の DI・Bean・Actuator・Security 資産をそのまま活かしながら、既存の Spring アプリにエージェントを組み込めます。',
  },
  {
    title: 'food-delivery-demo',
    body: 'クラウドキッチンの注文・配送システムを 10 サービスで実装した実証環境です。どのサービスにエージェントを置き、どのサービスには置かないかを意図的に設計し、マイクロサービスとエージェントの共存を動くコードで示します。',
  },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const routes = [
  {
    href: `${base}/essay`,
    label: 'Essay',
    body: '仮説の論拠、Arachne の設計意図、demo の読み方を長文で整理します。',
  },
  {
    href: `${base}/demo`,
    label: 'Demo',
    body: 'food-delivery-demo のサービス構成、設計上の判断、3 つの UI 公開面を解説します。',
  },
  {
    href: `${base}/observations`,
    label: 'Observations',
    body: '実際に food-delivery-demo を動かして確かめた振る舞いの記録です。原則ごとに仮説・観察・確認場所を整理します。',
  },
];
---

<SiteLayout title="Arachne Field Notes">
  <PageHero
    eyebrow="技術ブログ"
    title="マイクロサービスと AI エージェントを共存させる設計を、実装と動くデモで探索する"
    summary="クラウド・マイクロサービスと進化してきたバックエンド設計に、AI エージェントをどう融合するか──その問いに対して Spring 実装（Arachne）と動く実証環境（food-delivery-demo）で答えを探るブログです。"
  />

  <section class="section-grid">
    {pillars.map((pillar) => (
      <article class="panel">
        <p class="panel__eyebrow">{pillar.title}</p>
        <p>{pillar.body}</p>
      </article>
    ))}
  </section>

  <section class="story-band">
    <div>
      <p class="story-band__eyebrow">読む順番</p>
      <h2>問い・設計仮説・実証の 3 ステップが、このサイトの論理構造です</h2>
    </div>
    <ol class="story-band__list">
      <li><strong>Essay</strong> でマイクロサービスの原則を起点に、AI エージェントをどう融合するかという問いを立て、「自然言語フロントドア」という設計仮説を整理します。</li>
      <li><strong>Demo</strong> で food-delivery-demo の構成を確認し、どの設計判断がどの仮説に対応しているかを読みます。</li>
      <li><strong>Observations</strong> で実際に動かしたときの振る舞いを確認し、仮説が成立しているかを観察記録から追います。</li>
    </ol>
  </section>

  <section class="route-grid">
    {routes.map((route) => (
      <a class="route-card" href={route.href}>
        <span>{route.label}</span>
        <p>{route.body}</p>
      </a>
    ))}
  </section>
</SiteLayout>
