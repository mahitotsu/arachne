---
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const pillars = [
  {
    title: '問いと仮説',
    body: 'マイクロサービスの原則（責務境界・API 公開・チームの自律性・疎結合）を保ったまま、AI エージェントを組み込めるか。ここでの答えが「自然言語フロントドア」です。エージェントは API の代わりではなく、API の手前に置きます。',
  },
  {
    title: 'Arachne',
    body: 'AWS Strands Agents の Python SDK を Java に移植し、Spring Boot 統合を加えたエージェント実行フレームワークです。Spring の DI・Bean・Actuator・Security 資産をそのまま活かしながら、既存の Spring アプリにエージェントを組み込めます。',
  },
  {
    title: 'food-delivery-demo',
    body: 'クラウドキッチンの注文・配送システムを 10 サービスで実装した実証環境です。どのサービスにエージェントを置き、どのサービスには置かないかを意図的に設計し、マイクロサービスとエージェントの共存を動くコードで示します。',
  },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const routes = [
  {
    href: `${base}/essay`,
    label: 'Essay',
    body: '仮説の根拠、Arachne の設計意図、demo の読み方をまとめています。',
  },
  {
    href: `${base}/demo`,
    label: 'Demo',
    body: 'food-delivery-demo のサービス構成、設計上の判断、3 つの UI 公開面を解説します。',
  },
  {
    href: `${base}/observations`,
    label: 'Observations',
    body: '実際に food-delivery-demo を動かして確かめた振る舞いの記録です。原則ごとに仮説・観察・確認場所を整理します。',
  },
  {
    href: `${base}/conclusions`,
    label: 'Conclusions',
    body: '探索全体の評決と根拠をまとめます。6 原則の検証結果、残る問い、実装制約の整理です。',
  },
];
---

<SiteLayout title="Arachne Field Notes">
  <PageHero
    eyebrow="技術ブログ"
    title="マイクロサービスと AI エージェントを両立させる設計を、実装とデモで検証する"
    summary="このサイトは、AI エージェントを既存のマイクロサービス設計にどう組み込むかを扱います。Spring 実装（Arachne）と実証環境（food-delivery-demo）を使って、設計の妥当性を確認します。"
  />

  <section class="section-grid">
    {pillars.map((pillar) => (
      <article class="panel">
        <p class="panel__eyebrow">{pillar.title}</p>
        <p>{pillar.body}</p>
      </article>
    ))}
  </section>

  <section class="story-band">
    <div>
      <p class="story-band__eyebrow">読む順番</p>
      <h2>このサイトは「問い・設計仮説・実証」の 3 ステップで構成しています</h2>
    </div>
    <ol class="story-band__list">
      <li><strong>Essay</strong> で、マイクロサービス原則を起点に「自然言語フロントドア」という設計仮説を整理します。</li>
      <li><strong>Demo</strong> で food-delivery-demo の構成を確認し、どの設計判断がどの仮説に対応しているかを読みます。</li>
      <li><strong>Observations</strong> で実際の振る舞いを確認し、仮説が成り立つかを観察記録で検証します。</li>
      <li><strong>Conclusions</strong> で探索全体の評決と根拠、残る問いを読みます。</li>
    </ol>
  </section>

  <section class="route-grid">
    {routes.map((route) => (
      <a class="route-card" href={route.href}>
        <span>{route.label}</span>
        <p>{route.body}</p>
      </a>
    ))}
  </section>
</SiteLayout>
