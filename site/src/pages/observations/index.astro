---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const allObservations = await getCollection('observations');
const observations = allObservations.sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const verificationScope =
  'このサイトの Observation は food-delivery-demo を対象に取得したコード断片・API 仕様・実行記録に限定されます。未掲載の環境・期間・運用条件へは一般化しません。';
---

<SiteLayout title="Observations | Arachne Field Notes">
  <PageHero
    eyebrow="Observations"
    title="証拠を見る"
    summary="設計仮説に対して実際のソースコードと動作ログを証拠として示します。各観察は独立したページとして記録されています。"
  />

  <section class="panel">
    <p class="panel__eyebrow">検証範囲</p>
    <p>{verificationScope}</p>
  </section>

  <section class="panel">
    <p class="panel__eyebrow">この証拠記録の読み方</p>
    <p>
      各ページは「検証した仮説 → ソースコードの証拠 → 観察された振る舞い」の順で構成しています。
      「なぜこの仮説を支持できるか」の説明は <a href={`${base}/conclusions`}><strong>Conclusions</strong></a> にまとめています。
      このページ群の目的は、まず証拠を示すことです。
    </p>
  </section>

  <section class="stacked-list">
    {observations.map((obs) => (
      <article class="essay-card">
        <div>
          <p class="panel__eyebrow">{obs.data.fl}</p>
          <h2 style="font-size:1rem; font-weight:700; margin-bottom:6px">
            <a href={`${base}/observations/${obs.slug}`} style="color: inherit; text-decoration: none;">
              {obs.data.title}
            </a>
          </h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 8px">
            原則：{obs.data.principle}
          </p>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 10px">
            <strong>仮説：</strong>{obs.data.hypothesis}
          </p>
          <a href={`${base}/observations/${obs.slug}`} style="font-size: 0.85rem; color: var(--accent);">
            ソースコードと観察記録を見る →
          </a>
        </div>
      </article>
    ))}
  </section>

  <section class="panel" style="text-align:center">
    <p>各観察が仮説をどう裏づけるかは <a href={`${base}/conclusions`}><strong>Conclusions</strong></a> で説明しています。</p>
  </section>
</SiteLayout>
